# Maintainer: NAMI <nami@example.com>
# The source tarball is the release asset beside this file:
#   https://github.com/nami-hq/nami/releases/download/v0.1.0/nami-0.1.0.tar.gz
# Rebuild it with packaging/arch/build-source-tarball.sh after any source change,
# then update sha256sums below. The tarball excludes the PKGBUILD itself, so this
# file and its hash do not depend on each other.

pkgname=nami
pkgver=0.1.0
pkgrel=1
pkgdesc="A glass anime player for ani-cli"
arch=('x86_64')
url="https://github.com/nami-hq/nami"
license=('MIT')
depends=('ani-cli' 'yt-dlp' 'gtk3' 'nss' 'alsa-lib' 'libnotify' 'xdg-utils' 'at-spi2-core')
makedepends=('nodejs' 'npm')
options=('!strip' '!debug')

source=("$pkgname-$pkgver.tar.gz::https://github.com/nami-hq/nami/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('0b9b8e68bf09ce8872c09d1d74decd54981b6bc5a5afab0f3ad5ac9fad1a8538')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  npm ci
  npx electron-builder --linux dir --publish never
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -d "$pkgdir/opt/$pkgname"
  cp -a dist/linux-unpacked/. "$pkgdir/opt/$pkgname/"

  install -Dm644 packaging/rpm/nami.desktop "$pkgdir/usr/share/applications/nami.desktop"
  install -Dm644 build/icon.png "$pkgdir/usr/share/icons/hicolor/1024x1024/apps/nami.png"
}
